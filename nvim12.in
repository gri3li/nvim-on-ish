#!/bin/sh
# nvim12 — launcher for Neovim from Alpine v3.24 on iSH.
# Generated by install.sh from nvim12.in; @PREFIX@ is substituted at install time.

# iSH answers unimplemented syscalls with SIGSYS, which kills the process.
# Ignoring it makes the syscall just return ENOSYS, and libuv/musl fall back.
trap '' SYS

R=@PREFIX@
NV=$R/usr/bin/nvim

# Newer libraries for nvim only; cleared again inside the server (see below),
# so git, :!cmd, :terminal and LSP servers get the normal iSH environment.
export LD_LIBRARY_PATH="$R/usr/lib:$R/usr/lib/lua/5.1:$R/shim"

# Modes without a TUI: run nvim directly.
case "$1" in
  --version|-v|--help|-h|--headless|--embed|--api-info|-l|-es|-Es|--remote*)
    exec "$NV" "$@" ;;
esac

# The built-in TUI dies with SIGSYS while spawning its embedded server on iSH.
# Work around it: start a headless server ourselves and attach a remote UI.
SOCK="${TMPDIR:-/tmp}/nvim12-$$.sock"
rm -f "$SOCK"

"$NV" --headless --listen "$SOCK" --cmd 'lua vim.env.LD_LIBRARY_PATH = nil' "$@" </dev/null >/dev/null 2>&1 &
SRV=$!

cleanup() {
  kill "$SRV" 2>/dev/null
  rm -f "$SOCK"
}
trap cleanup EXIT HUP INT TERM

# Wait up to ~10 s for the server socket.
i=0
while [ ! -S "$SOCK" ] && [ "$i" -lt 100 ]; do
  if ! kill -0 "$SRV" 2>/dev/null; then
    echo "nvim12: server exited before start; try: $NV --headless $*" >&2
    exit 1
  fi
  sleep 0.1
  i=$((i + 1))
done

if [ ! -S "$SOCK" ]; then
  echo "nvim12: timed out waiting for server socket $SOCK" >&2
  exit 1
fi

"$NV" --remote-ui --server "$SOCK"
